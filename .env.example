# مفاتيح API للاتصال بالشبكات المختلفة
INFURA_API_KEY=your_infura_api_key_here
ALCHEMY_API_KEY=your_alchemy_api_key_here

# مفاتيح API للمسح الضوئي للعقود
ETHERSCAN_API_KEY=your_etherscan_api_key_here
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
ARBISCAN_API_KEY=your_arbiscan_api_key_here
OPTIMISM_API_KEY=your_optimism_api_key_here
BASESCAN_API_KEY=your_basescan_api_key_here

# المفتاح الخاص للحساب الذي سيقوم بنشر العقد وتوزيع التوكنات
# تحذير: لا تستخدم حسابًا يحتوي على أموال حقيقية كبيرة
# استخدم حسابًا منفصلًا مخصصًا لهذا الغرض فقط
PRIVATE_KEY=your_private_key_here

# عنوان المحفظة الخاصة بك (اختياري)
YOUR_ADDRESS=your_ethereum_address_here

# قائمة بعناوين المحافظ التي سيتم إرسال التوكنات المزيفة إليها (مفصولة بفواصل)
TARGET_ADDRESSES=address1,address2,address3
